# Reuse or build this exact source; install directly when reachable, through MDM away.
# Use delivery=direct or delivery=mdm to select a transport explicitly.
install-dev:
    just install-target ./scripts/install-dev "{{ device }}" "{{ optimized }}" "{{ delivery }}" "{{ compilation }}"

# Same build and install, forced onto this machine.
install-phone:
    RC_IOS_BUILD_HOST=local just install-target ./scripts/install-dev "{{ device }}" "{{ optimized }}" "{{ delivery }}" "{{ compilation }}"

# Prepare the same signed device artifact without contacting the phone.
ios-device-build:
    ./scripts/install-dev --build-only {{ if optimized != "true" { "--unoptimized" } else if compilation == "wholemodule" { "--optimized" } else { "--incremental-optimized" } }}

[private]
install-target $target $selected_device $optimization $delivery_mode $compilation_mode:
    #!/usr/bin/env bash
    set -euo pipefail
    cmd=(
        "./scripts/run-logged" "ios-device-install" "$target" --delivery "$delivery_mode"
    )
    if [[ -n "$selected_device" ]]; then
        cmd+=(--device "$selected_device")
    fi
    if [[ "$optimization" == "true" ]]; then
        case "$compilation_mode" in
            incremental) cmd+=(--incremental-optimized) ;;
            wholemodule) cmd+=(--optimized) ;;
            *) echo "compilation must be incremental or wholemodule" >&2; exit 2 ;;
        esac
    else
        cmd+=(--unoptimized)
    fi
    "${cmd[@]}"

