    ./dev-tools/rc-gateway e2e-upload-live

gateway-e2e-files-live *args:
    ./dev-tools/rc-gateway e2e-files-live {{ args }}

# Delegated jobs against a built gateway and its matched runtime package.
gateway-e2e-delegated-jobs-isolated candidate package:
    bun dev-tools/probes/delegated-jobs.mjs "{{ candidate }}" "{{ package }}"

gateway-e2e-query-admission-isolated $candidate:
    bun dev-tools/probes/query-admission.mjs "$candidate"

gateway-e2e-provider-fallback-isolated $candidate:
    bun dev-tools/probes/provider-fallback.mjs "$candidate"

# Configure the Tailscale-independent relay server from relay/ (docs/relay-route.md; run on the Mac mini).
relay-provision:
    python3 scripts/relay.py provision

# Install this Mac's relay tunnel and the route its gateway publishes on /relay.
relay-install-client:
    python3 scripts/relay.py install-client

# Check this Mac's gateway through the relay, including the refusals.
relay-probe:
    python3 scripts/relay.py probe

# Query the gateway observability journal (see AGENTS.md, Observability).
