# Deterministic local half of the candidate pipeline. CARGO_TARGET_DIR may point
# at a persistent remote cache; sccache is inherited from the host Cargo config.
# The candidate is stamped with its snapshot's identity and signed once here;
# installers verify that signature instead of re-signing.
[private]
gateway-candidate-local:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "${RC_COMPILATION_OWNER:-}" != 1 ]]; then
        exec python3 scripts/remote-build.py local-build gateway
    fi
    just gateway-check-local
    just gateway-bundle-local

[private]
gateway-release-local:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "${RC_COMPILATION_OWNER:-}" != 1 ]]; then
        exec python3 scripts/remote-build.py local-build gateway-release
    fi
    scripts/codex-runtime-approval check --json
    just gateway-bundle-local

[private]
gateway-bundle-local:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -n "${RC_BUILD_PROVENANCE:-}" ]]; then
        export RC_SOURCE_COMMIT="$(jq -r .sourceCommit "$RC_BUILD_PROVENANCE")"
        export RC_SOURCE_MODIFIED="$(jq -r .sourceModified "$RC_BUILD_PROVENANCE")"
    fi
    cargo build --manifest-path host-daemon-rs/Cargo.toml --release --locked
    repo_root="$PWD"
    source host-daemon-rs/scripts/gateway-bundle.sh
    target_dir="${CARGO_TARGET_DIR:-host-daemon-rs/target}"
    output="${RC_GATEWAY_CANDIDATE_OUTPUT:-$PWD/host-daemon-rs/target/deploy/$gateway_bundle_name}"
    rm -rf "$output"
    mkdir -p "$output/Contents/MacOS"
    cp "$gateway_bundle_source/Contents/Info.plist" "$output/Contents/Info.plist"
    mkdir -p "$output/Contents/Resources"
    cp THIRD_PARTY_NOTICES.md "$output/Contents/Resources/"
    cp -R LICENSES "$output/Contents/Resources/"
    binary="$output/Contents/MacOS/$gateway_executable_name"
    install -m 755 "$target_dir/release/$gateway_executable_name" "$binary"
    signing=(--sign -)
    signing_helper="$HOME/configs/skills/apple-devops/scripts/ensure-signing-keychain"
    if [[ -x "$signing_helper" ]]; then
        "$signing_helper" >/dev/null
        signing=(--keychain "$("$signing_helper" --path)" --sign "Developer ID Application")
    fi
    preview="$output/Contents/MacOS/rc-visual-preview"
    {{ visual_preview_swiftc }} -O -o "$preview"
    codesign --force "${signing[@]}" --timestamp=none "$preview"
    codesign --force "${signing[@]}" --timestamp=none "$output"
    codesign --verify --strict "$output"
    "$binary" --version
    shasum -a 256 "$binary"
    printf 'gateway_candidate=%s\n' "$output"

# Source, mutable caches, and resulting artifacts have explicit build owners.
gateway-candidate:
    python3 scripts/remote-build.py gateway

gateway-install:
    #!/usr/bin/env bash
    set -euo pipefail
    receipt="$(python3 scripts/remote-build.py gateway)"
    candidate="$(python3 -c 'import json,sys; print(json.load(sys.stdin)["artifact"])' <<<"$receipt")"
    just gateway-install-prebuilt "$candidate"

gateway-install-prebuilt gateway:
    scripts/shared-codex-host deploy local "$HOME/.codex/packages/standalone/current" "{{ gateway }}"

gateway-health:
    ./dev-tools/rc-gateway health

# Restart the running gateway through launchd. Active Claude and Codex work is
# captured, interrupted, and resumed automatically by the replacement.
gateway-restart host="local":
    #!/usr/bin/env bash
    set -euo pipefail
    command='launchctl kickstart -k "gui/$(id -u)/com.remote-coder.codex-gateway"'
    if [[ "{{ host }}" == local ]]; then
        bash -c "$command"
    else
        ssh -o BatchMode=yes -o ConnectTimeout=5 "{{ host }}" "$command"
    fi

# The standard Swift suite runs directly on macOS, without building or launching the iOS app.
core-test $test_id="":
    #!/usr/bin/env bash
    set -euo pipefail
    case "$test_id" in
        RemoteCoderTests/*|RemoteCoderUITests/*)
            echo "App-hosted selectors require just ios-simulator-test or just ios-ui-test; use core-test <suite> for migrated native tests." >&2
            exit 2
            ;;
    esac
    python3 scripts/remote-build.py core-test "$test_id"

