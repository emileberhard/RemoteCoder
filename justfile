verify-all:
    python3 scripts/remote-build.py verify-all

[private]
verify-local:
    python3 scripts/concurrent_lanes.py \
        --lane gateway 'just gateway-check-local' 'bun test dev-tools/tests/isolated-probes.test.mjs' \
        --lane apps 'just verify-apps-local'

[private]
verify-all-local:
    python3 scripts/concurrent_lanes.py \
        --lane gateway 'just gateway-check-local' 'bun test dev-tools/tests/isolated-probes.test.mjs' \
        --lane apps 'just verify-apps-local' 'just verify-simulator-local'

[private]
verify-apps-local:
    just --summary >/dev/null
    ./scripts/lint-glass
    ./scripts/lint-haptics
    ./scripts/lint-symbol-effects
    ./scripts/lint-interface-scale
    ./scripts/lint-platform-imports
    just ios-build-local
    just mac-build-local
    just core-test-local
    just mac-harness-build-local

[private]
verify-simulator-local:
    just ios-simulator-test-local RemoteCoderTests/StreamingRenderingTests RemoteCoderTests/TranscriptScrollTests RemoteCoderTests/TranscriptScrollRenderingTests RemoteCoderTests/ChatHistoryReadTests RemoteCoderTests/GatewayBusyStateTests 'RemoteCoderTests/ActiveTasksLiveActivityScopeTests/mainActivityCreationControl()'
