{
  "name": "remotecoder-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "start": "bun server/index.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "bun test",
    "check": "biome check .",
    "format": "biome check --write .",
    "protocol": "bun scripts/generate-protocol.ts && bun scripts/generate-native-models.ts"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "lucide-react": "1.55.0",
    "marked": "18.1.1",
    "mermaid": "12.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
