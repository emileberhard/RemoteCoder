#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["numpy==2.5.4"]
# ///
"""Measure scroll motion per recorded frame in a transcript crop of a variable-frame-rate screen recording."""

import argparse
import json
import math
import re
import shutil
import subprocess
import tempfile
from collections import Counter
from pathlib import Path

import numpy as np
from numpy.typing import NDArray

PTS = re.compile(r"\bn:\s*(\d+)\b.*?\bpts_time:\s*([-\d.]+)")
SEGMENT_GAP_SECONDS = 0.1


def vertical_shift(previous: NDArray, current: NDArray, limit: int) -> tuple[int, float]:
    a = previous - previous.mean(axis=0)
    b = current - current.mean(axis=0)
    norm = float(np.linalg.norm(a) * np.linalg.norm(b))
    if norm < 1e-6:
        return 0, 0.0
    size = 1 << (2 * len(a) - 1).bit_length()
    spectrum = np.conj(np.fft.rfft(a, size, axis=0)) * np.fft.rfft(b, size, axis=0)
    correlation = np.fft.irfft(spectrum.sum(axis=1), size) / norm
    limit = min(limit, len(a) // 2)
    shifts = np.concatenate((np.arange(0, limit + 1), np.arange(-limit, 0)))
    scores = np.concatenate((correlation[: limit + 1], correlation[size - limit:]))
    best = int(np.argmax(scores))
    zero = float(scores[0])
    if shifts[best] == 0 or scores[best] < 0.5 or scores[best] - zero < 0.02:
        return 0, zero
    return int(shifts[best]), float(scores[best])


def segments(frames: list[dict]) -> list[list[dict]]:
    moving = [frame for frame in frames if frame["shift"]]
    groups: list[list[dict]] = []
    for frame in moving:
        if groups and frame["t"] - groups[-1][-1]["t"] <= SEGMENT_GAP_SECONDS and \
                math.copysign(1, frame["shift"]) == math.copysign(1, groups[-1][-1]["shift"]):
            groups[-1].append(frame)
        else:
            groups.append([frame])
    return [group for group in groups if len(group) >= 3]


def summarize(frames: list[dict], refresh_hz: float) -> dict:
    vsync = 1 / refresh_hz
    intervals: Counter[int] = Counter()
    judder = 0
    total = 0
    summaries = []
    worst_gap = 0.0
    for group in segments(frames):
        times = np.array([frame["t"] for frame in group])
        shifts = np.array([frame["shift"] for frame in group], dtype=float)
        gaps = np.diff(times)
        speeds = np.abs(shifts[1:]) / np.maximum(gaps, 1e-6)
        typical = float(np.median(speeds))
        for gap, shift in zip(gaps, shifts[1:]):
            intervals[max(1, round(gap / vsync))] += 1
            worst_gap = max(worst_gap, float(gap))
            total += 1
            if typical and abs(abs(shift) - typical * gap) > max(2.0, 0.25 * typical * gap):
                judder += 1
        duration = float(times[-1] - times[0])
        summaries.append({
            "start": round(float(times[0]), 3), "seconds": round(duration, 3), "frames": len(group),
            "direction": "down" if shifts[0] > 0 else "up",
            "effectiveFps": round((len(group) - 1) / duration, 1) if duration else None,
            "medianPixelsPerSecond": round(typical, 1),
        })
    return {
        "refreshHz": refresh_hz,
        "movingIntervals": total,
        "intervalsByVsyncs": {str(key): intervals[key] for key in sorted(intervals)},
        "oneVsyncShare": round(intervals[1] / total, 3) if total else None,
        "skippedFrames": sum((key - 1) * count for key, count in intervals.items()),
        "worstGapMs": round(worst_gap * 1000, 1),
        "judderShare": round(judder / total, 3) if total else None,
        "effectiveFpsWhileMoving": round(total / sum(summary["seconds"] for summary in summaries), 1) if total else None,
        "segments": summaries,
    }


def analyze(args: argparse.Namespace) -> dict:
    for tool in ("ffmpeg", "ffprobe"):
        if shutil.which(tool) is None:
            raise ValueError(f"{tool} is required on PATH")
    if not args.video.is_file():
        raise ValueError(f"Recording not found: {args.video}")
    probe = json.loads(subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_streams", "-of", "json",
                                       str(args.video)], capture_output=True, text=True, check=True).stdout)["streams"]
    if not probe:
        raise ValueError("The recording has no video stream")
    width, height = int(probe[0]["width"]), int(probe[0]["height"])
    x, y, w, h = args.crop or (0, 0, width, height)
    if min(x, y) < 0 or min(w, h) <= 0 or x + w > width or y + h > height:
        raise ValueError("Crop must be x:y:width:height entirely inside the video")
    scaled_w, scaled_h = w // args.scale, h // args.scale
    command = ["ffmpeg", "-nostats", "-v", "info", "-ss", str(args.start), "-t", str(args.duration), "-i", str(args.video),
               "-vf", f"crop={w}:{h}:{x}:{y},scale={scaled_w}:{scaled_h}:flags=area,format=gray,showinfo",
               "-fps_mode", "passthrough", "-f", "rawvideo", "-pix_fmt", "gray", "pipe:1"]
    images: list[NDArray] = []
    with tempfile.TemporaryFile() as errors:
        with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=errors) as process:
            assert process.stdout is not None
            while data := process.stdout.read(scaled_w * scaled_h):
                if len(data) != scaled_w * scaled_h:
                    raise ValueError("FFmpeg returned a partial video frame")
                images.append(np.frombuffer(data, dtype=np.uint8).reshape(scaled_h, scaled_w).astype(np.float32))
        errors.seek(0)
        log = errors.read().decode(errors="replace")
    if process.returncode:
        raise ValueError(f"FFmpeg failed: {log[-2000:]}")
    times = {int(match[1]): float(match[2]) for match in PTS.finditer(log)}
    if len(times) != len(images) or len(images) < 2:
        raise ValueError(f"Decoded {len(images)} frames but read {len(times)} timestamps")
    frames = []
    for index, image in enumerate(images):
        shift, score = (0, 1.0) if index == 0 else vertical_shift(images[index - 1], image, args.max_shift // args.scale)
        changed = index > 0 and float(np.abs(image - images[index - 1]).mean()) > 0.5
        frames.append({"t": round(args.start + times[index], 5), "shift": shift * args.scale, "score": round(score, 3),
                       "changed": changed})
    result = {
        "video": str(args.video.resolve()), "crop": [x, y, w, h], "start": args.start, "frames": len(frames),
        **summarize(frames, args.refresh_hz),
        "interpretation": "Intervals count recorded frames in which the crop moved; the recorder writes a frame only "
            "when the screen changes, so a gap of n vsyncs while moving means n-1 frames were not presented or not "
            "captured. Calibrate the recorder against a known 120 Hz scroll before attributing gaps to the app.",
    }
    if args.output:
        args.output.mkdir(parents=True, exist_ok=True)
        (args.output / "frames.json").write_text(json.dumps(frames) + "\n")
        (args.output / "report.json").write_text(json.dumps(result, indent=2) + "\n")
    return result


def parse_crop(value: str) -> tuple[int, int, int, int]:
    try:
        parts = tuple(map(int, value.split(":")))
        if len(parts) == 4:
            return parts
    except ValueError:
        pass
    raise argparse.ArgumentTypeError("Expected x:y:width:height")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("video", type=Path)
    parser.add_argument("--crop", type=parse_crop, help="x:y:width:height in video pixels; exclude composer and edges")
    parser.add_argument("--start", type=float, default=0)
    parser.add_argument("--duration", type=float, default=60)
    parser.add_argument("--scale", type=int, default=2, help="downsample factor before matching")
    parser.add_argument("--max-shift", type=int, default=480, help="largest per-frame shift in video pixels")
    parser.add_argument("--refresh-hz", type=float, default=120)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    if args.scale < 1 or args.max_shift < args.scale or args.duration <= 0 or args.start < 0:
        parser.error("scale must be >= 1, max-shift >= scale, duration positive and start nonnegative")
    try:
        print(json.dumps(analyze(args), indent=2))
    except (ValueError, OSError, subprocess.SubprocessError, KeyError) as error:
        parser.exit(1, f"scroll-cadence-report: {error}\n")


if __name__ == "__main__":
    main()
