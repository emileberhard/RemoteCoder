#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["numpy==2.5.4", "pillow==13.0.0"]
# ///
"""Measure a transcript crop without treating a fade as a position change."""

import argparse
import csv
import json
import math
import shutil
import subprocess
from collections import Counter
from pathlib import Path

import numpy as np
from numpy.typing import NDArray
from PIL import Image, ImageDraw


def vertical_shift(previous: NDArray, current: NDArray) -> tuple[int, float]:
    left = previous.mean(axis=1, dtype=np.float64)
    right = current.mean(axis=1, dtype=np.float64)
    limit = min(80, len(left) // 4)
    if np.std(left) < 0.1 or np.std(right) < 0.1:
        return 0, 0.0

    def correlation(shift: int) -> float:
        a, b = (left[:-shift], right[shift:]) if shift > 0 else (
            (left[-shift:], right[:shift]) if shift < 0 else (left, right))
        a, b = a - a.mean(), b - b.mean()
        norm = float(np.linalg.norm(a) * np.linalg.norm(b))
        return float(a @ b) / norm if norm else 0.0

    zero = correlation(0)
    best, score = max(((offset, correlation(offset)) for offset in range(-limit, limit + 1)),
                      key=lambda pair: (pair[1], -abs(pair[0])))
    # Uniform opacity changes preserve the normalized profile. Require an
    # actual improvement over the stationary explanation before calling a jump.
    # Raw/rendered reflow changes glyph metrics too: the recorded regression
    # has only 0.47–0.60 correlation even at its correct 14 px displacement.
    if abs(best) < 2 or score < 0.45 or score - zero < 0.025:
        return 0, zero
    return best, score


OSCILLATION_WINDOW_FRAMES = 30


def oscillations(shifts: list[int]) -> list[tuple[int, int]]:
    pairs = []
    consumed: set[int] = set()
    for index, shift in enumerate(shifts):
        if not shift or index in consumed:
            continue
        for other in range(index + 1, min(index + 1 + OSCILLATION_WINDOW_FRAMES, len(shifts))):
            if other not in consumed and shift * shifts[other] < 0 and abs(shift + shifts[other]) <= 2:
                pairs.append((index, other))
                consumed.update((index, other))
                break
    return pairs


def analyze(args: argparse.Namespace) -> dict:
    for tool in ("ffmpeg", "ffprobe"):
        if shutil.which(tool) is None:
            raise ValueError(f"{tool} is required on PATH")
    if not args.video.is_file():
        raise ValueError(f"Recording not found: {args.video}")
    probe = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_streams",
                            "-of", "json", str(args.video)], capture_output=True, text=True, check=True)
    streams = json.loads(probe.stdout)["streams"]
    if not streams:
        raise ValueError("The recording has no video stream")
    width, height = int(streams[0]["width"]), int(streams[0]["height"])
    x, y, w, h = args.crop or (0, 0, width, height)
    if min(x, y) < 0 or min(w, h) <= 0 or x + w > width or y + h > height:
        raise ValueError("Crop must be x:y:width:height entirely inside the video")
    if args.start < 0 or args.duration <= 0 or args.contact_at < 0:
        raise ValueError("Start/contact-at must be nonnegative and duration positive")
    if not all(math.isfinite(value) for value in (args.start, args.duration, args.contact_at)):
        raise ValueError("Times must be finite")

    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    command = ["ffmpeg", "-v", "error", "-ss", str(args.start), "-i", str(args.video),
               "-t", str(args.duration), "-vf", f"crop={w}:{h}:{x}:{y},fps=60,format=gray",
               "-f", "rawvideo", "-pix_fmt", "gray", "pipe:1"]
    rows: list[tuple[float, float, int, float]] = []
    tiles: list[Image.Image] = []
    previous = None
    tile_start = round(args.contact_at * 60)
    with (output / "ffmpeg.log").open("wb") as errors:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=errors)
        try:
            assert process.stdout is not None
            while True:
                data = process.stdout.read(w * h)
                if not data:
                    break
                if len(data) != w * h:
                    raise ValueError("FFmpeg returned a partial video frame")
                frame = np.frombuffer(data, dtype=np.uint8).reshape(h, w)
                index = len(rows)
                if previous is None:
                    change, shift, score = 0.0, 0, 1.0
                else:
                    change = float(np.abs(frame.astype(np.int16) - previous).mean())
                    shift, score = vertical_shift(previous, frame)
                rows.append((args.start + index / 60, change, shift, score))
                if tile_start <= index < tile_start + 30:
                    image = Image.fromarray(frame)
                    image.thumbnail((220, 320))
                    tile = Image.new("RGB", (240, 350), "white")
                    tile.paste(image, (10, 25))
                    ImageDraw.Draw(tile).text((8, 5), f"{index / 60:.3f}s  shift {shift:+d}px", fill="black")
                    tiles.append(tile)
                previous = frame.astype(np.int16)
            if process.wait(timeout=30):
                raise ValueError(f"FFmpeg failed; see {output / 'ffmpeg.log'}")
        finally:
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            if process.stdout:
                process.stdout.close()
    if len(rows) < 2:
        raise ValueError("The selected recording window contains fewer than two frames")

    with (output / "frames.csv").open("w", newline="") as destination:
        writer = csv.writer(destination)
        writer.writerow(("video_seconds", "mean_luma_change", "vertical_shift_px", "correlation"))
        writer.writerows(rows)
    if tiles:
        sheet = Image.new("RGB", (6 * 240, math.ceil(len(tiles) / 6) * 350), "white")
        for index, tile in enumerate(tiles):
            sheet.paste(tile, ((index % 6) * 240, (index // 6) * 350))
        sheet.save(output / "contact-sheet.png")
    counts = Counter(index // 60 for index, row in enumerate(rows) if row[1] > 3)
    pairs = oscillations([row[2] for row in rows])
    result = {
        "video": str(args.video.resolve()), "crop": [x, y, w, h], "start": args.start,
        "sample_fps": 60, "frames": len(rows),
        "big_change_frames_by_second": dict(sorted(counts.items())),
        "opposite_shift_pairs": [{"first": rows[a][0], "second": rows[b][0],
                                  "shifts": [rows[a][2], rows[b][2]]} for a, b in pairs],
        "oscillation_candidates": len(pairs), "output": str(output),
        "interpretation": "Inspect candidate pairs in frames.csv/contact sheets. Exclude deliberate scrolling. "
            "Luma-change counts include intentional fades and growth; they are not bounded by publish counts.",
    }
    (output / "report.json").write_text(json.dumps(result, indent=2) + "\n")
    return result


def parse_crop(value: str) -> tuple[int, int, int, int]:
    try:
        parts = tuple(map(int, value.split(":")))
        if len(parts) == 4:
            return parts
    except ValueError:
        pass
    raise argparse.ArgumentTypeError("Expected x:y:width:height")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("video", type=Path)
    parser.add_argument("--start", type=float, default=0)
    parser.add_argument("--duration", type=float, default=15)
    parser.add_argument("--crop", type=parse_crop)
    parser.add_argument("--contact-at", type=float, default=0, help="Seconds into the selected window")
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    try:
        print(json.dumps(analyze(args), indent=2))
    except (ValueError, OSError, subprocess.SubprocessError, KeyError) as error:
        parser.exit(1, f"streaming-motion-report: {error}\n")


if __name__ == "__main__":
    main()
