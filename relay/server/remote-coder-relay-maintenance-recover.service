[Unit]
Description=Recover relay maintenance after a new boot
StartLimitIntervalSec=0
Wants=nftables.service ssh.service tinyproxy.service haproxy.service remote-coder-relay-hosts.service
After=nftables.service ssh.service tinyproxy.service haproxy.service remote-coder-relay-hosts.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/remote-coder-relay/maintenance-recover --watch
TimeoutStartSec=210
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
