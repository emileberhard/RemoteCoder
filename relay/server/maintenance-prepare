#!/usr/bin/python3
import subprocess
import sys

from maintenance_state import RelayTransaction, _reboot_window


def prepare():
    if not _reboot_window():
        raise RuntimeError("relay reboot window is not open")
    with RelayTransaction() as transaction:
        transaction.prepare_idle(40, 15)
        transaction.enqueue_reboot()
    print("relay reboot requested; the maintenance marker remains until recovery")


if __name__ == "__main__":
    try:
        prepare()
    except (
        OSError,
        RuntimeError,
        ValueError,
        TypeError,
        KeyError,
        subprocess.SubprocessError,
    ) as error:
        print(f"relay preparation: {error}", file=sys.stderr)
        sys.exit(1)
