#!/usr/bin/python3
import os
import subprocess
import sys
import time

from maintenance_state import (
    MARKER,
    RelayTransaction,
    boot_id,
    owner_locks,
    read_marker,
    remove_fence_and_marker,
)


def recover():
    if os.geteuid() != 0:
        raise RuntimeError("relay recovery requires root")
    try:
        MARKER.lstat()
    except FileNotFoundError:
        return
    with owner_locks():
        recover_preparing()


def recover_preparing():
    try:
        marker = read_marker()
        phase, previous_boot = marker["phase"], marker["boot_id"]
        current_boot = boot_id()
    except (OSError, ValueError, KeyError, TypeError) as error:
        raise RuntimeError(
            "invalid relay maintenance marker; keep the fence"
        ) from error
    if phase != "preparing" or previous_boot != current_boot:
        raise RuntimeError(
            "committed or new-boot maintenance requires verification; keep the fence"
        )
    remove_fence_and_marker()


def recover_new_boot(timeout_seconds):
    try:
        MARKER.lstat()
    except FileNotFoundError:
        return
    deadline = time.monotonic() + timeout_seconds
    last_error = "prerequisites did not become ready"
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError(f"new-boot relay recovery timed out: {last_error}")
        try:
            with RelayTransaction() as transaction:
                transaction.reopen_after_new_boot(min(10, remaining))
            print("relay admission reopened after local new-boot checks")
            return
        except (
            OSError,
            RuntimeError,
            ValueError,
            TypeError,
            KeyError,
            subprocess.SubprocessError,
        ) as error:
            last_error = str(error)
            print(
                f"relay new-boot recovery: {last_error}; retrying",
                file=sys.stderr,
                flush=True,
            )
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError(
                    f"new-boot relay recovery failed: {error}"
                ) from error
            time.sleep(min(10, remaining))


if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["--boot"]:
            recover_new_boot(180)
        elif not sys.argv[1:]:
            recover()
        else:
            raise RuntimeError("usage: maintenance-recover [--boot]")
    except (OSError, RuntimeError) as error:
        print(f"relay recovery: {error}", file=sys.stderr)
        sys.exit(1)
