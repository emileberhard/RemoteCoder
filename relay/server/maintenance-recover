#!/usr/bin/python3
import os
import subprocess
import sys

from maintenance_state import DIRECTORY, MARKER, boot_id, owner_locks, read_marker


def recover():
    if os.geteuid() != 0:
        raise RuntimeError("relay recovery requires root")
    try:
        MARKER.lstat()
    except FileNotFoundError:
        return
    with owner_locks():
        recover_preparing()


def recover_preparing():
    try:
        marker = read_marker()
        phase, previous_boot = marker["phase"], marker["boot_id"]
        current_boot = boot_id()
    except (OSError, ValueError, KeyError, TypeError) as error:
        raise RuntimeError(
            "invalid relay maintenance marker; keep the fence"
        ) from error
    if phase != "preparing" or previous_boot != current_boot:
        raise RuntimeError(
            "committed or new-boot maintenance requires verification; keep the fence"
        )
    result = subprocess.run(
        ["/usr/sbin/nft", "-f", "-"],
        input="destroy table inet remote_coder_relay_maintenance\n",
        text=True,
        capture_output=True,
        timeout=10,
        check=False,
    )
    if result.returncode:
        raise RuntimeError("could not reopen relay admission; keep the marker")
    MARKER.unlink()
    directory_fd = os.open(DIRECTORY, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


if __name__ == "__main__":
    try:
        recover()
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"relay recovery: {error}", file=sys.stderr)
        sys.exit(1)
