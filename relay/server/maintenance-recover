#!/usr/bin/python3
import os
import subprocess
import sys
import time

from maintenance_state import (
    MARKER,
    RelayTransaction,
)


def recover():
    if os.geteuid() != 0:
        raise RuntimeError("relay recovery requires root")
    try:
        MARKER.lstat()
    except FileNotFoundError:
        return
    with RelayTransaction() as transaction:
        print(transaction.reconcile_pending(10))


def recover_pending(timeout_seconds):
    try:
        MARKER.lstat()
    except FileNotFoundError:
        return
    deadline = time.monotonic() + timeout_seconds
    last_error = "prerequisites did not become ready"
    while True:
        try:
            MARKER.lstat()
        except FileNotFoundError:
            return
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError(f"relay recovery timed out: {last_error}")
        try:
            with RelayTransaction() as transaction:
                result = transaction.reconcile_pending(min(10, remaining))
            print(result)
            return
        except (
            OSError,
            RuntimeError,
            ValueError,
            TypeError,
            KeyError,
            subprocess.SubprocessError,
        ) as error:
            last_error = str(error)
            print(
                f"relay maintenance recovery: {last_error}; retrying",
                file=sys.stderr,
                flush=True,
            )
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError(f"relay recovery failed: {error}") from error
            time.sleep(min(10, remaining))


if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["--watch"]:
            recover_pending(180)
        elif not sys.argv[1:]:
            recover()
        else:
            raise RuntimeError("usage: maintenance-recover [--watch]")
    except (
        OSError,
        RuntimeError,
        ValueError,
        TypeError,
        KeyError,
        subprocess.SubprocessError,
    ) as error:
        print(f"relay recovery: {error}", file=sys.stderr)
        sys.exit(1)
