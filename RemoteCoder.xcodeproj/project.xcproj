  "targets": [
    {
      "name": "RemoteCoder",
      "id": "TEMP_41D29B9C-0C5F-4729-BC76-8F5FF0326655",
      "product": "id:TEMP_BE237CF3-CAAA-4924-8F82-E448B1B52D99",
      "product-type": "application",
      "specialized-configurations": [
        {
          "name": "Debug",
          "file": "Project/Config/RemoteCoder.xcconfig"
        },
        {
          "name": "Release",
          "file": "Project/Config/RemoteCoder.xcconfig"
        }
      ],
      "dependencies": [
        "RemoteCoderCaptureExtension",
        "RemoteCoderLiveActivities",
        "RemoteCoderLocationPushService",
        "RemoteCoderNotificationService",
        "RemoteCoderShareExtension"
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory"
        },
        {
          "kind": "copy",
          "name": "Embed ExtensionKit Extensions",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(EXTENSIONS_FOLDER_PATH)"
        },
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory"
        }
      ],
      "package-product-members": [
        {
          "product-name": "DictationLibrary",
          "build-phase": {
            "build-phase": "frameworks"
          }
        },
        {
          "product-name": "GoogleNavigation",
          "build-phase": {
            "build-phase": "frameworks"
          }
        },
        {
          "product-name": "SpeechKit",
          "build-phase": {
            "build-phase": "frameworks"
          }
        },
        {
          "product-name": "WebRTC",
          "build-phase": {
            "build-phase": "frameworks"
          }
        }
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "$(RC_APP_ENTITLEMENTS)",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_PREVIEWS": "YES",
        "EXCLUDED_SOURCE_FILE_NAMES": [
          "$(inherited)",
          ".gitkeep",
          ".DS_Store",
          "AGENTS.md",
          "CLAUDE.md"
        ],
        "INFOPLIST_FILE": "$(RC_IOS_INFOPLIST_FILE)",
        "RC_IOS_INFOPLIST_FILE": "Config/InfoPlists/RemoteCoder-Info.plist",
        "INFOPLIST_KEY_CFBundleShortVersionString": "$(MARKETING_VERSION)",
        "INFOPLIST_KEY_CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
