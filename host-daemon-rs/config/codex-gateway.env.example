# shellcheck shell=bash
#
# Copy to: ~/.remote-coder/codex-gateway.env
# Then: chmod 600 ~/.remote-coder/codex-gateway.env
#
# Prefer scripts/setup.py to create a private file with a random token.
# For manual setup, generate the token with: openssl rand -hex 32

RC_CODEX_GATEWAY_BIND_HOST=127.0.0.1
RC_CODEX_GATEWAY_PORT=8787
# Point at the canonical managed Codex executable installed by RemoteCoder.
# Its executable `bin/codex-code-mode-host` sibling is required and validated
# before the gateway starts; copying the codex executable alone is unsupported.
RC_CODEX_GATEWAY_CODEX_PATH=/Users/you/.local/share/remotecoder/codex-package/bin/codex
RC_CODEX_GATEWAY_AUTH_TOKEN=replace-me

# Optional llm-router: leave all four values unset for native Codex/Claude login.
# Configure all four together to enable router-owned accounts, titles and speech.
# scripts/install-router-key.zsh takes inference and accounts origins plus a key
# on stdin. Remote origins require the exact allowed-origins list as well.
# RC_CODEX_GATEWAY_ROUTER_URL=https://inference.example.com
# RC_CODEX_GATEWAY_ROUTER_ACCOUNTS_URL=https://accounts.example.com
# RC_CODEX_GATEWAY_ROUTER_KEY_FILE=/Users/you/.remote-coder/llm-router.key
# RC_CODEX_GATEWAY_ROUTER_CODEX_ACCOUNT=your-router-codex-account-id
# RC_CODEX_GATEWAY_ROUTER_ALLOWED_ORIGINS=https://inference.example.com,https://accounts.example.com

# Optional: pinned-TLS listener on 0.0.0.0 for the app on the home network; off when unset.
# RC_CODEX_GATEWAY_LAN_PORT=8789

# Optional: RUST_LOG filter for the gateway, without touching launchd.
# RC_CODEX_GATEWAY_LOG=remote_coder_codex_gateway=debug

# Optional: push broker for RemoteCoder completion alerts and Live Activities.
# The launch agent can source an operator-provided env file before this file.
# RC_PUSH_BROKER_TOKEN=replace-me
# RC_PUSH_BROKER_URL=http://127.0.0.1:5012
# RC_PUSH_BROKER_ENV=production
RC_CODEX_GATEWAY_PUSH_BROKER_ENABLED=false

# Optional: which clients may use the /speech relay for dictation and spoken
# replies. Unset (or `all`) admits every authenticated client; otherwise list
# installation IDs separated by commas. An empty value fails startup. The
# operator token is always admitted. This limits usage and spend; it does not
# protect keys, since an installation credential already grants /ws and
# command/exec.
# Provider keys never live here: speech runs through llm-router's vendor
# passthrough with the router key above.
# RC_CODEX_GATEWAY_SPEECH_CLIENTS=all

# Absolute path to the real CLI. Leave unset to use ~/.local/bin/claude, then PATH.
# RC_CLAUDE_PATH=/Users/you/.local/bin/claude
# Only set RC_CLAUDE_HOME for a custom profile; the default keeps ~/.claude.json.
# RC_CLAUDE_HOME=/absolute/custom/claude
