#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
    echo "usage: run-logged <operation-name> <command> [args...]" >&2
    exit 2
fi

operation_name="$1"
shift
if [[ ! "$operation_name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "operation name must contain only lowercase letters, numbers, and hyphens" >&2
    exit 2
fi

log_dir="${RC_DEPLOY_LOG_DIR:-$HOME/Library/Logs/remote-coder/deployments}"
timestamp="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
log_file="$log_dir/$operation_name-$timestamp.log"
mkdir -p "$log_dir"

commit="$(git rev-parse HEAD 2>/dev/null || printf 'not-a-git-repository')"
{
    printf 'operation=%s\n' "$operation_name"
    printf 'startedAtUtc=%s\n' "$timestamp"
    printf 'host=%s\n' "$(hostname)"
    printf 'workingDirectory=%s\n' "$PWD"
    printf 'gitCommit=%s\n' "$commit"
    set +e
    "$@"
    command_status="$?"
    set -e
    exit "$command_status"
} 2>&1 | tee "$log_file"
status="${PIPESTATUS[0]}"
printf 'log=%s\n' "$log_file"
exit "$status"
