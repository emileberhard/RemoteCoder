#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["pydantic>=2.12,<3"]
# ///

import argparse
import hashlib
import importlib.util
import json
import os
import platform
import sqlite3
import stat
import subprocess
import sys
import tempfile
import threading
from pathlib import Path
from typing import Annotated, Any, Literal

from build_artifacts import tree_digest
from pydantic import (
    BaseModel,
    ConfigDict,
    Field,
    StringConstraints,
    TypeAdapter,
    ValidationError,
)

ADOPTION = Path("host-daemon-rs/src/accounts/codex_migration")
FRESH_HOME_SECONDS = 60

Sha256 = Annotated[str, StringConstraints(pattern=r"^[0-9a-f]{64}$")]
GitCommit = Annotated[str, StringConstraints(pattern=r"^[0-9a-f]{40}$")]
CodexVersion = Annotated[
    str, StringConstraints(pattern=r"^[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$")
]


class ApprovalError(RuntimeError):
    pass


class Binary(BaseModel):
    model_config = ConfigDict(extra="forbid")
    sha256: Sha256


class PackageManifest(BaseModel):
    """The package fields that authorize a matched runtime."""

    model_config = ConfigDict(extra="forbid")
    layout_version: Literal[1] = Field(alias="layoutVersion")
    version: CodexVersion
    target: Literal["aarch64-apple-darwin", "x86_64-unknown-linux-musl"]
    variant: Literal["codex"]
    entrypoint: Literal["bin/codex"]
    exec_server: Literal["bin/codex-exec-server"] | None = Field(default=None, alias="execServer")
    resources_dir: Literal["codex-resources"] = Field(alias="resourcesDir")
    path_dir: Literal["codex-path"] = Field(alias="pathDir")
    linux_sandbox: Literal["system"] | None = Field(default=None, alias="linuxSandbox")
    source_commit: GitCommit = Field(alias="sourceCommit")
    binaries: dict[str, Binary]


class RuntimeHashes(BaseModel):
    model_config = ConfigDict(extra="ignore")
    codex: Sha256 = Field(alias="bin/codex")
    code_mode_host: Sha256 = Field(alias="bin/codex-code-mode-host")
    exec_server: Sha256 | None = Field(default=None, alias="bin/codex-exec-server")


class TargetApproval(BaseModel):
    model_config = ConfigDict(extra="forbid")
    source_commit: GitCommit = Field(alias="sourceCommit")
    hashes: RuntimeHashes = Field(alias="runtimeHashes")
    package_sha256: Sha256 = Field(alias="runtimePackageSHA256")


class Compatibility(BaseModel):
    model_config = ConfigDict(extra="ignore")
    version: CodexVersion = Field(alias="codexCliVersion")
    protocol_source_commit: GitCommit = Field(alias="protocolSourceCommit")
    targets: dict[
        Literal["aarch64-apple-darwin", "x86_64-unknown-linux-musl"], TargetApproval
    ] = Field(alias="runtimeTargets")


class Approval(BaseModel):
    model_config = ConfigDict(extra="forbid")
    version: CodexVersion
    target: Literal["aarch64-apple-darwin", "x86_64-unknown-linux-musl"]
    source_commit: GitCommit
    codex_sha256: Sha256
    code_mode_host_sha256: Sha256
    exec_server_sha256: Sha256 | None = None


class Evaluation(BaseModel):
    model_config = ConfigDict(extra="forbid")
    schema_version: Literal[1] = 1
    approval: Approval
    package_sha256: Sha256
    adoption_pins_sha256: Sha256
    adoption_migrations: dict[str, int]


def compatibility_path(root: Path) -> Path:
    path = root.resolve() / "docs/codex/compatibility.json"
    if not path.is_file():
        raise ApprovalError(f"missing approval file: {path}")
    return path


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(
        description="Validate or update RemoteCoder's matched Codex runtime approval.",
        epilog=(
            "Examples:\n"
            "  codex-runtime-approval check --json\n"
            "  codex-runtime-approval check --package /tmp/codex-package\n"
            "  codex-runtime-approval apply --package /tmp/codex-package --json"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--repo-root",
        type=Path,
        default=Path(__file__).resolve().parent.parent,
        help="RemoteCoder root (default: inferred from this script)",
    )
    common.add_argument("--json", action="store_true", help="emit stable JSON")
    common.add_argument(
        "--target", choices=["aarch64-apple-darwin", "x86_64-unknown-linux-musl"]
    )
    subcommands = command.add_subparsers(dest="command", required=True)
    check = subcommands.add_parser(
        "check", parents=[common], help="validate the approval record"
    )
    check.add_argument(
        "--package", type=Path, help="also verify and compare a built package"
    )
    apply = subcommands.add_parser(
        "apply", parents=[common], help="set the approval from a verified package"
    )
    apply.add_argument("--package", type=Path, required=True)
    apply.add_argument(
        "--source-dir",
        type=Path,
        help="exact fork checkout, required for a target-only source patch",
    )
    evaluate = subcommands.add_parser(
        "evaluate",
        parents=[common],
        help="execute package adoption checks on its native host",
    )
    evaluate.add_argument("--package", type=Path, required=True)
    evaluate.add_argument("--output", type=Path, required=True)
    apply_set = subcommands.add_parser(
        "apply-set",
        parents=[common],
        help="atomically approve native evaluations and a common protocol source",
    )
    apply_set.add_argument("--receipt", type=Path, action="append", required=True)
    apply_set.add_argument("--protocol-source-commit", required=True)
    apply_set.add_argument("--source-dir", type=Path, required=True)
    subcommands.add_parser(
        "export", parents=[common], help="emit the selected flat package approval"
    )
    install = subcommands.add_parser(
        "install-record",
        parents=[common],
        help="install immutable approval beside an already approved package",
    )
    install.add_argument("--package", type=Path, required=True)
    resolve = subcommands.add_parser(
        "resolve", parents=[common], help="resolve the approved immutable build package"
    )
    resolve.add_argument(
        "--packages-dir",
        type=Path,
        default=Path.home() / "Library/Caches/RemoteCoder-Build/codex-runtime/packages",
    )
    resolve.set_defaults(package=None)
    return command


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text())
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ApprovalError(f"cannot read valid JSON from {path}: {error}") from error


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    try:
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
    except OSError as error:
        raise ApprovalError(f"cannot hash {path}: {error}") from error
    return digest.hexdigest()


def requires_exec_server(version: str) -> bool:
    return tuple(map(int, version.split("-", 1)[0].split("+", 1)[0].split("."))) >= (0, 166, 0)


def package_approval(package: Path) -> Approval:
    package = package.resolve()
    manifest_path = package / "codex-package.json"
    try:
        manifest = PackageManifest.model_validate(load_json(manifest_path))
    except ValidationError as error:
        raise ApprovalError(
            f"invalid package manifest {manifest_path}: {error}"
        ) from error
    linux = manifest.target == "x86_64-unknown-linux-musl"
    if linux != (manifest.linux_sandbox == "system"):
        raise ApprovalError("Linux packages must explicitly require system bubblewrap")
    fallback = package / "codex-resources/bwrap"
    if linux:
        try:
            fallback.lstat()
        except FileNotFoundError:
            pass
        else:
            raise ApprovalError("Linux packages must not bundle a bubblewrap fallback")

    if requires_exec_server(manifest.version) and manifest.exec_server is None:
        raise ApprovalError("Codex 0.166 and newer require the packaged exec server")
    expected_paths = {"bin/codex", "bin/codex-code-mode-host"}
    if manifest.exec_server is not None:
        expected_paths.add(manifest.exec_server)
    if set(manifest.binaries) != expected_paths:
        raise ApprovalError(
            f"package binaries must be exactly {sorted(expected_paths)}"
        )
    for relative_path, record in manifest.binaries.items():
        binary = package / relative_path
        if not binary.is_file() or not os.access(binary, os.X_OK):
            raise ApprovalError(
                f"package binary is missing or not executable: {binary}"
            )
        actual = file_sha256(binary)
        if actual != record.sha256:
            raise ApprovalError(
                f"hash mismatch for {relative_path}: manifest={record.sha256} actual={actual}"
            )
    return Approval(
        version=manifest.version,
        target=manifest.target,
        source_commit=manifest.source_commit,
        codex_sha256=manifest.binaries["bin/codex"].sha256,
        code_mode_host_sha256=manifest.binaries["bin/codex-code-mode-host"].sha256,
        exec_server_sha256=(manifest.binaries[manifest.exec_server].sha256 if manifest.exec_server else None),
    )


def repo_approval(path: Path, target: str) -> Approval:
    try:
        compatibility = Compatibility.model_validate(load_json(path))
    except ValidationError as error:
        raise ApprovalError(f"invalid compatibility approval: {error}") from error
    selected = compatibility.targets.get(target)
    if selected is None:
        raise ApprovalError(f"no approved runtime for {target}")
    return Approval(
        version=compatibility.version,
        target=target,
        source_commit=selected.source_commit,
        codex_sha256=selected.hashes.codex,
        code_mode_host_sha256=selected.hashes.code_mode_host,
        exec_server_sha256=selected.hashes.exec_server,
    )


def write_atomic(path: Path, content: str) -> None:
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
            temporary = Path(handle.name)
        temporary.chmod(path.stat().st_mode & 0o777 if path.exists() else 0o644)
        os.replace(temporary, path)
    except OSError as error:
        if temporary:
            temporary.unlink(missing_ok=True)
        raise ApprovalError(f"cannot update {path}: {error}") from error


def runtime_hashes(approval: Approval) -> dict[str, str]:
    if requires_exec_server(approval.version) and approval.exec_server_sha256 is None:
        raise ApprovalError("Codex 0.166 and newer require the exec server digest")
    hashes = {
        "bin/codex": approval.codex_sha256,
        "bin/codex-code-mode-host": approval.code_mode_host_sha256,
    }
    if approval.exec_server_sha256 is not None:
        hashes["bin/codex-exec-server"] = approval.exec_server_sha256
    return hashes


def flat_record(approval: Approval) -> dict[str, Any]:
    return {
        "codexCliVersion": approval.version,
        "codexForkCommit": approval.source_commit,
        "runtimeHashes": runtime_hashes(approval),
    }


def install_record(package: Path, approval: Approval) -> None:
    package = package.resolve()
    directory_path = package.parent / "approvals"
    directory_path.mkdir(exist_ok=True)
    path = directory_path / f"{file_sha256(package / 'codex-package.json')}.json"
    record = flat_record(approval)
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            "w", dir=directory_path, delete=False
        ) as handle:
            json.dump(record, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fchmod(handle.fileno(), 0o444)
            os.fsync(handle.fileno())
            temporary = Path(handle.name)
        try:
            os.link(temporary, path)
        except FileExistsError:
            metadata = path.lstat()
            if not stat.S_ISREG(metadata.st_mode) or metadata.st_mode & 0o222:
                raise ApprovalError(
                    "installed approval must be a read-only regular file"
                )
            if load_json(path) != record:
                raise ApprovalError(
                    "installed approval differs; refusing to replace it"
                )
        directory = os.open(directory_path, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def resolve_package(path: Path, packages: Path, target: str) -> Path:
    compatibility = Compatibility.model_validate(load_json(path))
    expected = repo_approval(path, target)
    selected = compatibility.targets[target]
    for package in sorted(packages.glob("*")):
        if not package.is_dir():
            continue
        try:
            if (
                package_approval(package) == expected
                and tree_digest(package) == selected.package_sha256
            ):
                return package.resolve()
        except (ApprovalError, OSError, ValueError):
            continue
    raise ApprovalError(
        f"approved immutable package {selected.source_commit} "
        f"with fingerprint {selected.package_sha256} is absent from {packages}"
    )


def request(
    server: subprocess.Popen[str], identifier: int, method: str, params: dict[str, Any]
) -> Any:
    server.stdin.write(
        json.dumps({"id": identifier, "method": method, "params": params}) + "\n"
    )
    server.stdin.flush()
    for line in server.stdout:
        try:
            message = json.loads(line)
        except json.JSONDecodeError as error:
            raise ApprovalError(
                f"approved runtime wrote invalid JSON-RPC: {error}"
            ) from error
        if message.get("id") == identifier and "method" not in message:
            if "error" in message:
                raise ApprovalError(
                    f"approved runtime rejected {method}: {message['error']}"
                )
            return message["result"]
    raise ApprovalError(f"approved runtime exited before answering {method}")


def create_fresh_home(codex: Path, home: Path) -> None:
    (home / "memories_v2_1.sqlite").touch()
    server = subprocess.Popen(
        [str(codex), "app-server"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env={"HOME": str(home), "CODEX_HOME": str(home), "PATH": "/usr/bin:/bin"},
        cwd=home,
        text=True,
    )
    deadline = threading.Timer(FRESH_HOME_SECONDS, server.kill)
    deadline.start()
    try:
        with server:
            request(
                server,
                1,
                "initialize",
                {
                    "clientInfo": {"name": "codex-runtime-approval", "version": "1"},
                    "capabilities": {"experimentalApi": True},
                },
            )
            server.stdin.write(json.dumps({"method": "initialized"}) + "\n")
            thread = request(
                server,
                2,
                "thread/start",
                {
                    "cwd": str(home),
                    "historyMode": "paginated",
                    "model": "gpt-5.4",
                    "approvalPolicy": "never",
                    "sandbox": "read-only",
                },
            )["thread"]["id"]
            request(
                server,
                3,
                "thread/name/set",
                {"threadId": thread, "name": "adoption pins"},
            )
    finally:
        deadline.cancel()
    if server.returncode != 0:
        raise ApprovalError(
            f"approved runtime app-server exited with {server.returncode}"
        )


def adoption_pins(root: Path, package: Path) -> dict[str, int]:
    directory = root.resolve() / ADOPTION
    specification = importlib.util.spec_from_file_location(
        "codex_adoption", directory / "native.py"
    )
    if specification is None or specification.loader is None:
        raise ApprovalError(f"cannot load {directory / 'native.py'}")
    native = importlib.util.module_from_spec(specification)
    specification.loader.exec_module(native)
    pins = load_json(directory / "schema.json")
    latest = {}
    with tempfile.TemporaryDirectory() as temporary:
        home = Path(temporary).resolve()
        create_fresh_home(package.resolve() / "bin/codex", home)
        unknown = native.unclassified_databases(home, pins)
        missing = sorted(name for name in pins if not (home / name).exists())
        if unknown or missing:
            raise ApprovalError(
                f"approved runtime databases differ from the adoption pins (unknown {unknown}, "
                f"missing {missing}); classify them in {directory / 'native.py'}"
            )
        for name in sorted(pins):
            path = home / name
            try:
                with native.connect(path, True) as connection:
                    fingerprint = native.fingerprint(connection)
                    try:
                        native.validate(connection, path, pins[name])
                    except ValueError as error:
                        raise ApprovalError(
                            f"{error}. The approved runtime creates {name} with schema "
                            f"{fingerprint['schema']} and migrations {fingerprint['migrations']} "
                            f"through {fingerprint['latestMigration']}; review what those migrations "
                            f"require {directory / 'native.py'} to copy or preserve, then update "
                            f"{directory / 'schema.json'}"
                        ) from error
            except (ValueError, sqlite3.Error) as error:
                raise ApprovalError(
                    f"cannot fingerprint {name} from the approved runtime: {error}"
                ) from error
            latest[name] = fingerprint["latestMigration"]
    return latest


def verify_source(protocol: str, approval: Approval, source: Path | None) -> None:
    if approval.source_commit == protocol:
        return
    if source is None:
        raise ApprovalError("target-only source changes require --source-dir")
    ancestry = subprocess.run(
        [
            "git",
            "-C",
            str(source),
            "merge-base",
            "--is-ancestor",
            protocol,
            approval.source_commit,
        ],
        capture_output=True,
        check=False,
    )
    if ancestry.returncode != 0:
        raise ApprovalError(
            "target source must descend from the common protocol source"
        )
    changed = subprocess.check_output(
        [
            "git",
            "-C",
            str(source),
            "diff",
            "--name-only",
            protocol,
            approval.source_commit,
        ],
        text=True,
    ).splitlines()
    allowed = {"codex-rs/utils/pty/src/process_identity.rs"}
    if approval.target == "x86_64-unknown-linux-musl":
        allowed |= {
            "REMOTECODER_MODIFICATIONS.md",
            "scripts/codex_package/cargo.py",
            "scripts/codex_package/cli.py",
            "scripts/codex_package/layout.py",
            "scripts/codex_package/test_cargo.py",
            "scripts/codex_package/test_layout.py",
        }
    if not changed or set(changed) - allowed:
        raise ApprovalError(
            "target source changes shared protocol/state or an unreviewed platform path"
        )


def apply(path: Path, approval: Approval, package_sha256: str) -> None:
    compatibility = load_json(path)
    if (
        compatibility["codexCliVersion"] != approval.version
        and len(compatibility["runtimeTargets"]) > 1
    ):
        raise ApprovalError("a version change must update every target together")
    compatibility["codexCliVersion"] = approval.version
    compatibility["runtimeTargets"][approval.target] = {
        "sourceCommit": approval.source_commit,
        "runtimePackageSHA256": package_sha256,
        "runtimeHashes": runtime_hashes(approval),
    }
    write_atomic(path, json.dumps(compatibility, indent=2, ensure_ascii=False) + "\n")


def apply_set(
    path: Path, root: Path, receipts: list[Path], protocol: str, source: Path
) -> dict[str, Any]:
    protocol = TypeAdapter(GitCommit).validate_python(protocol)
    compatibility = load_json(path)
    previous = Compatibility.model_validate(compatibility)
    if subprocess.run(
        [
            "git",
            "-C",
            str(source),
            "merge-base",
            "--is-ancestor",
            previous.protocol_source_commit,
            protocol,
        ],
        capture_output=True,
        check=False,
    ).returncode:
        raise ApprovalError(
            "the common protocol source must descend from its previous approval"
        )
    evaluations = [
        Evaluation.model_validate(load_json(receipt)) for receipt in receipts
    ]
    targets = [evaluation.approval.target for evaluation in evaluations]
    if len(set(targets)) != len(targets) or not set(previous.targets) <= set(targets):
        raise ApprovalError(
            "atomic approval requires exactly one evaluation for every existing target"
        )
    versions = {evaluation.approval.version for evaluation in evaluations}
    if len(versions) != 1:
        raise ApprovalError("all targets must use one Codex version")
    pins_sha256 = file_sha256(root.resolve() / ADOPTION / "schema.json")
    migrations = {
        tuple(sorted(evaluation.adoption_migrations.items()))
        for evaluation in evaluations
    }
    if len(migrations) != 1 or set(evaluations[0].adoption_migrations) != set(
        load_json(root.resolve() / ADOPTION / "schema.json")
    ):
        raise ApprovalError(
            "all targets must create the same pinned adoption databases and migrations"
        )
    selected = {}
    for evaluation in evaluations:
        if evaluation.adoption_pins_sha256 != pins_sha256:
            raise ApprovalError("native evaluation used different adoption schema pins")
        approval = evaluation.approval
        verify_source(protocol, approval, source)
        selected[approval.target] = {
            "sourceCommit": approval.source_commit,
            "runtimePackageSHA256": evaluation.package_sha256,
            "runtimeHashes": flat_record(approval)["runtimeHashes"],
        }
    compatibility["codexCliVersion"] = versions.pop()
    compatibility["protocolSourceCommit"] = protocol
    compatibility["runtimeTargets"] = selected
    write_atomic(path, json.dumps(compatibility, indent=2, ensure_ascii=False) + "\n")
    return compatibility


def host_target() -> str:
    target = (platform.system(), platform.machine())
    if target == ("Darwin", "arm64"):
        return "aarch64-apple-darwin"
    if target == ("Linux", "x86_64"):
        return "x86_64-unknown-linux-musl"
    raise ApprovalError(f"no supported Codex package for {target}")


def emit(payload: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(payload, sort_keys=True))
    else:
        print(payload["message"])
        print(json.dumps(payload["approval"], indent=2, sort_keys=True))


def main() -> int:
    args = parser().parse_args()
    try:
        path = compatibility_path(args.repo_root)
        if args.command == "apply-set":
            approved = apply_set(
                path,
                args.repo_root,
                args.receipt,
                args.protocol_source_commit,
                args.source_dir,
            )
            print(json.dumps({"ok": True, "compatibility": approved}, sort_keys=True))
            return 0
        target = args.target or host_target()
        if args.command == "export":
            print(json.dumps(flat_record(repo_approval(path, target)), sort_keys=True))
            return 0
        if args.command == "resolve":
            args.package = resolve_package(path, args.packages_dir, target)
        expected = package_approval(args.package) if args.package else None
        if expected is not None:
            if args.target and expected.target != args.target:
                raise ApprovalError("package target differs from --target")
            target = expected.target
        adoption = None
        if args.command == "evaluate":
            if expected is None or target != host_target():
                raise ApprovalError(
                    "evaluation must execute on the package's operating system and architecture"
                )
            adoption = adoption_pins(args.repo_root, args.package)
            receipt = Evaluation(
                approval=expected,
                package_sha256=tree_digest(args.package),
                adoption_pins_sha256=file_sha256(
                    args.repo_root.resolve() / ADOPTION / "schema.json"
                ),
                adoption_migrations=adoption,
            )
            args.output.parent.mkdir(parents=True, exist_ok=True)
            write_atomic(args.output, receipt.model_dump_json(indent=2) + "\n")
            print(
                json.dumps(
                    {"ok": True, "evaluation": receipt.model_dump()}, sort_keys=True
                )
            )
            return 0
        if args.command == "apply":
            if expected is None:
                raise ApprovalError("apply requires a verified package")
            if target != host_target():
                raise ApprovalError(
                    "approval must execute on the package's operating system and architecture"
                )
            verify_source(
                Compatibility.model_validate(load_json(path)).protocol_source_commit,
                expected,
                args.source_dir,
            )
            adoption = adoption_pins(args.repo_root, args.package)
            apply(path, expected, tree_digest(args.package))
        actual = repo_approval(path, target)
        if expected is not None and actual != expected:
            raise ApprovalError(
                "repository approval does not match the verified package"
            )
        if args.command == "install-record":
            install_record(args.package, actual)
        if args.command == "resolve" and not args.json:
            print(args.package)
            return 0
        emit(
            {
                "ok": True,
                "message": (
                    "updated and verified the Codex runtime approval"
                    if args.command == "apply"
                    else "installed immutable Codex runtime approval"
                    if args.command == "install-record"
                    else "Codex runtime approval record is valid"
                ),
                "approval": actual.model_dump(),
                "adoptionMigrations": adoption,
                "package": str(args.package.resolve()) if args.package else None,
            },
            args.json,
        )
        return 0
    except (ApprovalError, OSError, UnicodeError, ValidationError) as error:
        if args.json:
            print(json.dumps({"ok": False, "error": str(error)}, sort_keys=True))
        else:
            print(f"Codex runtime approval failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
