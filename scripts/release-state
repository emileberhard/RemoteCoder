#!/usr/bin/env python3
import argparse
import io
import json
import os
import subprocess
import zipfile
from pathlib import Path


def api(path):
    return subprocess.check_output(['gh', 'api', path])


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('name')
    parser.add_argument('destination', type=Path)
    args = parser.parse_args()
    repo, run = os.environ['GITHUB_REPOSITORY'], os.environ['GITHUB_RUN_ID']
    artifacts = json.loads(api(f'repos/{repo}/actions/runs/{run}/artifacts?per_page=100'))['artifacts']
    matches = [a for a in artifacts if a['name'] == args.name]
    if any(a['expired'] for a in matches):
        raise SystemExit('The release state artifact expired; reconcile it and release a new patch.')
    if len(matches) > 1:
        raise SystemExit(f'Multiple artifacts named {args.name}; the release state is ambiguous.')
    if not matches:
        return
    with zipfile.ZipFile(io.BytesIO(api(f"repos/{repo}/actions/artifacts/{matches[0]['id']}/zip"))) as archive:
        for member in archive.infolist():
            path = args.destination / member.filename
            if not path.resolve().is_relative_to(args.destination.resolve()):
                raise SystemExit('Release state artifact contains an invalid path.')
        archive.extractall(args.destination)


if __name__ == '__main__':
    main()
